# Lowercase ASCII DNS hostname only: no scheme, path, port, quotes, or slash.
RADAR_DOMAIN=radar.example.com

# Used only for ACME account and certificate-expiry notices.
ACME_EMAIL=admin@example.com

COMPOSE_PROJECT_NAME=cs2-radar-public
RADAR_RELAY_IMAGE=cs2-radar-relay:local
CADDY_IMAGE=cs2-radar-caddy:2.11.4

# This file is generated locally and must never be committed.
RELAY_CONFIG_FILE=./secrets/relay-config.json

# Persistent certificate/account state. Create these directories as UID/GID
# 65532 before starting the non-root Caddy container.
CADDY_DATA_DIR=./state/caddy-data
CADDY_CONFIG_DIR=./state/caddy-config
